digraph JenkinsDocker {
  graph [rankdir=TB, bgcolor="transparent", margin="0.24", pad="0.2", nodesep="0.45", ranksep="0.58", splines="ortho", fontname="DejaVu Sans"];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=13, penwidth=1.35, margin="0.23,0.16"];
  edge [color="#7085A1", penwidth=1.8, arrowsize=0.7, fontname="DejaVu Sans", fontsize=10, fontcolor="#4A5D76"];
  engineer [label="DEVOPS ENGINEER\nJenkins Web UI", fillcolor="#E8F1FF", color="#9DBDEC", fontcolor="#15355D"];
  controller [label="AWS EC2  |  JENKINS CONTROLLER\nUbuntu  •  Java 21  •  Jenkins  •  Docker\nSchedules and manages deployment jobs", fillcolor="#DDEAFF", color="#4B8CE8", fontcolor="#17345B"];
  agent [label="AWS EC2  |  JENKINS AGENT\nUbuntu  •  Java 21  •  Docker\nNode label: docker-slave\nExecutes the Freestyle build", fillcolor="#E2F5EF", color="#43A98D", fontcolor="#174C3F"];
  container [label="NGINX  |  DOCKER CONTAINER\nOfficial image: nginx:1.30.6\nHost 8081  →  Container 80", fillcolor="#EDF7EA", color="#66A963", fontcolor="#2B512D"];
  browser [label="WEB BROWSER\nHTTP to agent public port 8081", fillcolor="#FFF2DF", color="#E6B15C", fontcolor="#66502B"];
  engineer -> controller [xlabel="UI :8080"];
  controller -> agent [xlabel="SSH on private IP :22"];
  agent -> container [xlabel="docker pull / docker run"];
  container -> browser [xlabel="Page served to visitor", color="#6B9C76"];
}
